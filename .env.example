# 서버 설정
PORT=3000
HOST=localhost
NODE_ENV=development

# 세션 보안 키 (프로덕션에서는 반드시 변경)
# 프로덕션(NODE_ENV=production)에서는 필수이며, 없으면 서버가 시작되지 않습니다.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 데이터베이스 경로
DB_PATH=./database

# 보안 설정
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000

# 파일 업로드 설정
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# 사이트 설정
SITE_NAME=서브컬처 포럼
SITE_DESCRIPTION=Node.js 기반 커뮤니티 포럼
DEFAULT_LANGUAGE=ko
TIMEZONE=Asia/Seoul

# 쿠키/프록시 (프로덕션)
# NODE_ENV=production 이면 세션 쿠키는 Secure(HTTPS 전용)가 됩니다. HTTP 로 운영해야 하면 COOKIE_SECURE=false
# nginx 등 리버스 프록시 뒤에서 HTTPS 를 종료한다면 TRUST_PROXY=1 (프록시 홉 수) 로 설정하세요.
#COOKIE_SECURE=
#TRUST_PROXY=
