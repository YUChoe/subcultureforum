<%- include('../layouts/main', {
    title: title,
    body: `
        <main class="container">
            <!-- 메인 헤더 -->
            <header class="hero">
                <hgroup>
                    <h1>🎮 NOIZZE</h1>
                    <p>게임, 애니메이션, 만화 등 서브컬처를 사랑하는 사람들의 커뮤니티</p>
                </hgroup>

                ${user ?
                    '<div class="welcome-message"><p>👋 환영합니다, <strong>' + escapeHtml(user.username) + '</strong>님!</p></div>' :
                    '<div class="cta-buttons"><a href="/auth/register" role="button">🚀 지금 가입하기</a><a href="/auth/login" role="button" class="outline">🔑 로그인</a></div>'
                }

                <!-- 사이트 통계 -->
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-number">${totalPosts.toLocaleString()}</span>
                        <span class="stat-label">게시글</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">${totalUsers.toLocaleString()}</span>
                        <span class="stat-label">회원</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">${totalCategories.toLocaleString()}</span>
                        <span class="stat-label">포럼</span>
                    </div>
                </div>
            </header>

            <!-- 검색 폼 -->
            <section class="search-section">
                <div class="search-container">
                    <form method="GET" action="/forum/search">
                        <fieldset role="group">
                            <input type="search" name="q" placeholder="🔍 게시글, 댓글 검색..." autocomplete="off">
                            <button type="submit">검색</button>
                        </fieldset>
                    </form>
                </div>
            </section>

            <!-- 포럼 카테고리 목록 -->
            <section class="categories-section">
                <header>
                    <h2>📂 포럼 카테고리</h2>
                    ${user && user.role === 'super_admin' ?
                        '<a href="/admin/forums/new" role="button" class="outline">➕ 새 카테고리</a>' : ''
                    }
                </header>

                ${categories && categories.length > 0 ? `
                    <div class="categories-grid">
                        ${categories.map(category => `
                            <article class="forum-category">
                                <header>
                                    <h3>
                                        <a href="/forum/subforum/${category.id}" class="category-link">
                                            ${escapeHtml(category.name)}
                                        </a>
                                    </h3>
                                </header>

                                ${category.recent_posts && category.recent_posts.length > 0 ? `
                                    <div class="recent-posts-list">
                                        ${category.recent_posts.map(post => `
                                            <div class="recent-post-item">
                                                <a href="/forum/subforum/${category.id}/post/${post.id}" class="post-link">
                                                    ${escapeHtml(post.title)}
                                                </a>
                                                <div class="post-meta">
                                                    <span class="post-author">${escapeHtml(post.username)}</span>
                                                    <span class="post-date">${new Date(post.created_at).toLocaleDateString('ko-KR')}</span>
                                                </div>
                                            </div>
                                        `).join('')}
                                    </div>
                                ` : `
                                    <div class="no-posts">
                                        <p>게시글이 없습니다.</p>
                                    </div>
                                `}
                            </article>
                        `).join('')}
                    </div>
                ` : `
                    <article class="empty-state">
                        <header>
                            <h3>🏗️ 포럼 준비 중</h3>
                        </header>
                        <p>아직 생성된 포럼 카테고리가 없습니다.</p>
                        ${user && user.role === 'super_admin' ?
                            '<footer><a href="/admin/forums/new" role="button">첫 번째 카테고리 만들기</a></footer>' :
                            '<footer><p><em>관리자가 곧 포럼을 개설할 예정입니다.</em></p></footer>'
                        }
                    </article>
                `}
            </section>

            <!-- 인기 게시글 -->
            ${popularPosts && popularPosts.length > 0 ? `
                <section>
                    <h2>🔥 인기 게시글</h2>
                    <div class="grid">
                        ${popularPosts.map(post => `
                            <article>
                                <header>
                                    <h4>
                                        <a href="/forum/subforum/${post.category_id}/post/${post.id}">
                                            ${escapeHtml(post.title)}
                                        </a>
                                    </h4>
                                </header>
                                <footer>
                                    <small>
                                        ${escapeHtml(post.subforum_name)} |
                                        ${escapeHtml(post.username || '알 수 없음')} |
                                        조회 ${post.view_count} |
                                        댓글 ${post.comment_count}
                                    </small>
                                </footer>
                            </article>
                        `).join('')}
                    </div>
                </section>
            ` : ''}


        </main>
    `
}) %>